# LLM API Keys (Keep private, never commit .env)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM Model Configuration
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-flash

# Providers: 'claude', 'gemini', or 'rules' (rule-based offline parser)
PARSER_PROVIDER=rules

# Rerank Provider: 'claude', 'gemini', or 'off'
RERANK_PROVIDER=off
